{
  "name": "claude-village",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A floating 3D village for watching Claude Code work. Read-only and local.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "npm run build && node dist/server/main.js",
    "serve": "node dist/server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "assets": "node scripts/build-assets.mjs",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "meshoptimizer": "^0.22.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
